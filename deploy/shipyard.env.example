# /etc/shipyard/shipyard.env: read by systemd (EnvironmentFile=).
# Owner root:shipyard, mode 0640. Contains credentials: never commit a real copy.

# PostgreSQL connection (required). Use a local Unix socket or 127.0.0.1 only.
SHIPYARD_DATABASE_URL=postgres://shipyard:CHANGE_ME@127.0.0.1:5432/shipyard?sslmode=disable

# Logging: level debug|info|warn|error (default info), format json|text (default json).
SHIPYARD_LOG_LEVEL=info
SHIPYARD_LOG_FORMAT=json

# Grace period for in-flight work on shutdown (default 15s).
SHIPYARD_SHUTDOWN_TIMEOUT=15s

# API listen address: host:port on loopback, or unix:/absolute/path.sock.
# Non-loopback addresses are refused unless SHIPYARD_API_ALLOW_PUBLIC_LISTEN=true;
# public traffic must arrive through Caddy.
# The systemd unit overrides this with a Unix socket.
SHIPYARD_API_LISTEN=127.0.0.1:8080

# Key encryption keys for environment secrets (ADR-0005). Each <kek_id>.key file
# holds exactly 32 random bytes, owned by root, group shipyard, mode 0640:
#   head -c 32 /dev/urandom > /etc/shipyard/kek/k1.key
# Back the directory up separately from the database. The active KEK seals
# new values; every KEK in the directory can still open older ones.
SHIPYARD_KEK_DIR=/etc/shipyard/kek
SHIPYARD_KEK_ACTIVE=k1

# Worker identity in operation leases (default: <hostname>-<pid>) and queue poll interval (default 2s).
# SHIPYARD_WORKER_ID=
SHIPYARD_WORKER_POLL_INTERVAL=2s

# Worker: one checkout per running operation (created with mode 0700), and
# where repositories are cloned from (https; plain http only on loopback).
SHIPYARD_WORK_DIR=/var/lib/shipyard/work
SHIPYARD_SOURCE_BASE_URL=https://github.com

# Worker: the buildx builder (docker-container driver) and its caps, applied
# when the worker creates it at start. To change the caps of an existing
# builder, remove it first: docker buildx rm shipyard (ADR-0004).
SHIPYARD_BUILDER=shipyard
SHIPYARD_BUILDER_MEMORY=2g
SHIPYARD_BUILDER_CPUS=2

# Worker: the Caddy edge container (ADR-0003), kept running by the worker. It
# is the only container that publishes host ports. Its admin API is only a
# Unix socket in SHIPYARD_CADDY_ADMIN_DIR, which the worker makes group-owned
# by its own group with mode 2770. The image defaults to the pinned
# caddy:2.11.4-alpine digest; set SHIPYARD_CADDY_IMAGE only to upgrade.
SHIPYARD_CADDY=true
SHIPYARD_CADDY_NAME=shipyard-caddy
SHIPYARD_CADDY_ADMIN_DIR=/run/shipyard/caddy
# SHIPYARD_CADDY_IMAGE=
# SHIPYARD_CADDY_BIND=          # empty: all interfaces
SHIPYARD_CADDY_HTTP_PORT=80
SHIPYARD_CADDY_HTTPS_PORT=443
