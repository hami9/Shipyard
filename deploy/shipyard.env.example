# /etc/shipyard/shipyard.env: read by systemd (EnvironmentFile=).
# Owner root:shipyard, mode 0640. Contains credentials: never commit a real copy.

# PostgreSQL connection (required). Use a local Unix socket or 127.0.0.1 only.
SHIPYARD_DATABASE_URL=postgres://shipyard:CHANGE_ME@127.0.0.1:5432/shipyard?sslmode=disable

# Logging: level debug|info|warn|error (default info), format json|text (default json).
SHIPYARD_LOG_LEVEL=info
SHIPYARD_LOG_FORMAT=json

# Grace period for in-flight work on shutdown (default 15s).
SHIPYARD_SHUTDOWN_TIMEOUT=15s

# API listen address: host:port on loopback, or unix:/absolute/path.sock.
# Anything else is refused: public traffic arrives through Caddy only. Both
# services read it: the worker mounts the socket's directory into Caddy.
SHIPYARD_API_LISTEN=unix:/run/shipyard-api/api.sock
# The public name Caddy serves the API on, over HTTPS (HTTP/2): /v1/* and
# /hooks/github only. Its A/AAAA records must point at this server. Empty
# publishes nothing; apps can never take this name.
SHIPYARD_API_HOSTNAME=

# Key encryption keys for environment secrets (ADR-0005). Each <kek_id>.key file
# holds exactly 32 random bytes, owned by root, group shipyard, mode 0640:
#   head -c 32 /dev/urandom > /etc/shipyard/kek/k1.key
# Back the directory up separately from the database. The active KEK seals
# new values; every KEK in the directory can still open older ones.
SHIPYARD_KEK_DIR=/etc/shipyard/kek
SHIPYARD_KEK_ACTIVE=k1

# API and worker: the worker serves app logs on this Unix socket (mode 0660,
# shared group) and the API reads it; the API never touches Docker (ADR-0008).
SHIPYARD_WORKER_SOCKET=/run/shipyard-worker/logs.sock

# API: domains. A new hostname is accepted only if every A/AAAA record points
# at one of these public IPs (comma-separated), so Let's Encrypt validation
# cannot fail on a stray record. Set SHIPYARD_DNS_PREFLIGHT=false to skip it.
# SHIPYARD_DOMAIN_SUFFIXES optionally restricts hostnames to these domains.
# CHANGE_ME: this server's public IPv4 (and IPv6, if DNS has AAAA records).
SHIPYARD_PUBLIC_IPS=203.0.113.10
SHIPYARD_DNS_PREFLIGHT=true
# SHIPYARD_DOMAIN_SUFFIXES=example.com,apps.example.org

# Worker identity in operation leases (default: <hostname>-<pid>) and queue poll interval (default 2s).
# SHIPYARD_WORKER_ID=
SHIPYARD_WORKER_POLL_INTERVAL=2s
# Reconciler period: requeue expired operations and re-sync Caddy from the
# routes table, which is how added or removed domains take effect (default 60s).
SHIPYARD_RECONCILE_INTERVAL=60s
# After a switch, the previous release keeps running this long, then the
# reconciler stops it with the app's stop_timeout (0s to 24h; default 5m).
SHIPYARD_OBSERVATION_WINDOW=5m
# Image retention: besides the running release's image, each app keeps the
# images of this many earlier releases, its rollback targets (0 to 1000;
# default 5). The reconciler removes the others it built.
SHIPYARD_RETAIN_IMAGES=5
# The rest of retention runs at start and then every interval (default 24h):
# the build cache is pruned down to a cap (sizes: 512m, 10g, …), and only each
# app's newest operations keep their build and deploy logs, each capped.
SHIPYARD_RETENTION_INTERVAL=24h
SHIPYARD_BUILD_CACHE_MAX=10g
SHIPYARD_RETAIN_OPERATIONS=20
SHIPYARD_OPERATION_LOG_MAX=5m

# Backups (`shipyard-worker backup`, run nightly by shipyard-backup.timer).
# Target A gets one directory per backup: the database dump, Caddy's data, and
# a manifest. Target B gets the KEK files. The two must be separate, and
# apart from SHIPYARD_KEK_DIR: never keep the keys next to what they open.
# Both must exist, owned by shipyard-worker, mode 0700, and be listed in
# ReadWritePaths= of shipyard-backup.service.
SHIPYARD_BACKUP_DIR=/var/backups/shipyard
SHIPYARD_BACKUP_KEK_DIR=/var/backups/shipyard-kek
# Optional commands (sh -c) that copy a target off-host after it is written.
# $SHIPYARD_BACKUP_PATH is the new backup directory (A) or the KEK directory
# (B). Send them to two different places. A failing hook fails the backup run.
# Single-quote the value: systemd then passes it to the shell unchanged.
# SHIPYARD_BACKUP_HOOK='rclone copy "$SHIPYARD_BACKUP_PATH" "offsite-a:shipyard/$(basename "$SHIPYARD_BACKUP_PATH")"'
# SHIPYARD_BACKUP_KEK_HOOK='rsync -a "$SHIPYARD_BACKUP_PATH/" keys@other-host:shipyard-kek/'
# Target A keeps the newest backup of each of the last 14 days and 8 weeks.
SHIPYARD_BACKUP_KEEP_DAILY=14
SHIPYARD_BACKUP_KEEP_WEEKLY=8
# pg_dump must not be older than the server's major version (PostgreSQL 18).
# SHIPYARD_BACKUP_PG_DUMP=/usr/lib/postgresql/18/bin/pg_dump

# Worker: one checkout per running operation (created with mode 0700), and
# where repositories are cloned from (https; plain http only on loopback).
SHIPYARD_WORK_DIR=/var/lib/shipyard/work
SHIPYARD_SOURCE_BASE_URL=https://github.com

# Worker: the buildx builder (docker-container driver) and its caps, applied
# when the worker creates it at start. To change the caps of an existing
# builder, remove it first: docker buildx rm shipyard (ADR-0004).
SHIPYARD_BUILDER=shipyard
SHIPYARD_BUILDER_MEMORY=2g
SHIPYARD_BUILDER_CPUS=2

# Worker: the Caddy edge container (ADR-0003), kept running by the worker. It
# is the only container that publishes host ports. Its admin API is only a
# Unix socket in SHIPYARD_CADDY_ADMIN_DIR, which the worker makes group-owned
# by its own group with mode 2770. The image defaults to the pinned
# caddy:2.11.4-alpine digest; set SHIPYARD_CADDY_IMAGE only to upgrade.
SHIPYARD_CADDY=true
SHIPYARD_CADDY_NAME=shipyard-caddy
SHIPYARD_CADDY_ADMIN_DIR=/run/shipyard/caddy
# SHIPYARD_CADDY_IMAGE=
# SHIPYARD_CADDY_BIND=          # empty: all interfaces
SHIPYARD_CADDY_HTTP_PORT=80
SHIPYARD_CADDY_HTTPS_PORT=443
# Certificates: empty = Caddy's defaults (Let's Encrypt, then ZeroSSL),
# staging = Let's Encrypt staging (tests on a real domain), internal = Caddy's
# own CA (machines without public DNS). The email is used for ACME accounts.
SHIPYARD_CADDY_CA=
# SHIPYARD_ACME_EMAIL=ops@example.com
