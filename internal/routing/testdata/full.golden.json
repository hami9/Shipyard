{
  "admin": {
    "listen": "unix//run/shipyard/caddy/caddy-admin.sock|0660"
  },
  "apps": {
    "http": {
      "servers": {
        "shipyard": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "shipyard.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "match": [
                        {
                          "path": [
                            "/v1/*",
                            "/hooks/github"
                          ]
                        }
                      ],
                      "handle": [
                        {
                          "handler": "reverse_proxy",
                          "upstreams": [
                            {
                              "dial": "unix//run/shipyard/api/api.sock"
                            }
                          ]
                        }
                      ],
                      "terminal": true
                    },
                    {
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 404
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "api-docs.example.org"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "172.20.0.5:8080"
                    }
                  ]
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "idle.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 503,
                  "body": "no active deployment\n"
                }
              ],
              "terminal": true
            },
            {
              "match": [
                {
                  "host": [
                    "web.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "shipyard-web-11111111-1111-4111-8111-111111111111:3000"
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    }
  }
}
