{
  "admin": {
    "listen": "unix//run/shipyard/caddy/caddy-admin.sock|0660"
  },
  "apps": {
    "http": {
      "servers": {
        "shipyard": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "match": [
                {
                  "host": [
                    "web.example.com"
                  ]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "shipyard-web-11111111-1111-4111-8111-111111111111:3000"
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "module": "acme",
                "ca": "https://acme-staging-v02.api.letsencrypt.org/directory",
                "email": "ops@example.com"
              }
            ]
          }
        ]
      }
    }
  }
}
